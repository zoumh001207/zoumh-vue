# 环境变量配置示例
# 复制此文件为 .env.development、.env.production、.env.staging 并修改相应配置

# ============================================
# 开发环境配置 (.env.development)
# ============================================
# 页面标题
VITE_APP_TITLE = 若依管理系统

# 开发环境配置
ENV = 'development'

# 若依管理系统/开发环境
# 使用 /dev-api 会通过 vite.config.js 中的代理转发到后端
VITE_APP_BASE_API = '/dev-api'

# 路由懒加载
VITE_ROUTER_MODE = 'hash'

# 生产环境配置
VITE_APP_ENV = 'production'

# ============================================
# 生产环境配置 (.env.production)
# ============================================
# VITE_APP_BASE_API = 'http://localhost:8080'
# 或使用相对路径（需要 Nginx 代理）
# VITE_APP_BASE_API = '/prod-api'

# ============================================
# 测试环境配置 (.env.staging)
# ============================================
# VITE_APP_BASE_API = 'http://your-test-server:8080'
